# URL do Twojego projektu w Supabase
VITE_SUPABASE_URL="https://twoj-projekt.supabase.co"

# Publiczny klucz ANON KEY z Supabase (nigdy nie umieszczaj tu klucza service_role!)
VITE_SUPABASE_ANON_KEY="twoj-klucz-anon-key"

# URL do backendu FastAPI
VITE_API_URL="http://localhost:8000"

# Główny URL aplikacji oraz URL przekierowania po zalogowaniu przez Google OAuth
VITE_APP_URL="http://localhost:5173/"
VITE_AUTH_REDIRECT_URL="http://localhost:5173/"
